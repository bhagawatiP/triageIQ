# ============================================================
#  CXone Swarm Triage — configuration template
#  Copy this file to  config.env  and fill in your own values,
#  then start the server:  python triage_server.py
# ============================================================

# --- Atlassian: Jira + Confluence ---
# Your Atlassian account email, and an API token from:
#   https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_USERNAME=PASTE_YOUR_ATLASSIAN_EMAIL_HERE
CONFLUENCE_TOKEN=PASTE_YOUR_ATLASSIAN_API_TOKEN_HERE

# --- Xray Cloud API key ---
# Create in Jira → Apps → Xray → API Keys (client id + secret)
XRAY_CLIENT_ID=PASTE_YOUR_XRAY_CLIENT_ID_HERE
XRAY_CLIENT_SECRET=PASTE_YOUR_XRAY_CLIENT_SECRET_HERE

# --- Optional settings (sensible defaults; uncomment to override) ---
JIRA_BASE_URL=https://nice-ce-cxone-prod.atlassian.net
XRAY_PROJECT=CXDV
TRIAGE_PORT=8756
# CLAUDE_BIN=                 # auto-detected from the VS Code extension; set to override

# Code-RCA source. Auto-cloned from this git repo into <project>/.external/ on first run
# (needs GitHub access to the private nice-cxone org). Override PMN_SHARED_DIR to reuse an
# existing local clone instead of cloning.
# PMN_SHARED_REPO=https://github.com/nice-cxone/cxone-cxdvi-pmn-shared
# PMN_SHARED_BRANCH=develop
# PMN_SHARED_DIR=             # default: <project>/.external/cxone-cxdvi-pmn-shared

# Test bed is BUNDLED in the repo (testbed/). Override only to point elsewhere.
# TESTBED_DIR=               # default: <project>/testbed

# TRIAGE_ALLOW_DANGEROUS=0    # 1 = allow Bash in the agent (unsafe with untrusted input)
